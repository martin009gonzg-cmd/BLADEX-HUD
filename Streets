local function getSources()
    local sources = {}
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if bp   and bp.Parent   then table.insert(sources, bp)   end
    if char and char.Parent then table.insert(sources, char) end
    return sources
end

local function getItemConfig(item)
    local cfg = item:FindFirstChild("Configuration")
    if cfg then return cfg end
    -- Buscar en hijos directos (armas tipo Model que contienen otro tool)
    for _, child in ipairs(item:GetChildren()) do
        local nested = child:FindFirstChild("Configuration")
        if nested then return nested end
    end
    return nil
end

local function getWeapons()
    local weapons = {}
    for _, source in ipairs(getSources()) do
        for _, item in ipairs(source:GetChildren()) do
            local cfg = getItemConfig(item)
            if cfg then table.insert(weapons, { item = item, cfg = cfg }) end
        end
    end
    return weapons
end


local function startWeaponLoop()
    if weaponLoopConn then weaponLoopConn:Disconnect() end
    weaponLoopConn = RunService.Heartbeat:Connect(function()
        local anyActive = _G.NoRecoil or _G.NoSpread or _G.RapidFire or _G.InfiniteAmmo
        if not anyActive then return end

        for _, w in ipairs(getWeapons()) do
            local cfg  = w.cfg
            local item = w.item

            if _G.NoRecoil then
                for _, prop in ipairs(RECOIL_PROPS) do
                    local inst = cfg:FindFirstChild(prop)
                    if inst and inst.Value ~= 0 then inst.Value = 0 end
                end
            end

            if _G.NoSpread then
                for _, prop in ipairs(SPREAD_PROPS) do
                    local inst = cfg:FindFirstChild(prop)
                    if inst and inst.Value ~= 0 then inst.Value = 0 end
                end
            end

            if _G.RapidFire then
                local inst = cfg:FindFirstChild("ShotCooldown")
                if inst and inst.Value > 0.05 then inst.Value = 0.05 end
            end

            if _G.InfiniteAmmo then
                local cap = cfg:FindFirstChild("AmmoCapacity")
                if cap then
                    local ca = item:FindFirstChild("CurrentAmmo")
                    if not ca and item.Parent then
                        ca = item.Parent:FindFirstChild("CurrentAmmo")
                    end
                    if ca and ca.Value < cap.Value then ca.Value = cap.Value end
                end
            end
        end
    end)
    Logger.ok("WEAPON LOOP", "Loop unificado iniciado")
end

