local function showFOVCircle()
    SA_FOV_SHOW = true
    if fovHideTask then task.cancel(fovHideTask) end
    fovHideTask = task.delay(1.5, function()
        SA_FOV_SHOW = false
        fovCircleOuter.Visible = false
        fovCircleInner.Visible = false
        fovHideTask = nil
    end)
end

local function updateFOVCircle()
    if not SA_FOV_SHOW then return end
    local vp  = Camera.ViewportSize
    local cx  = vp.X / 2
    local cy  = vp.Y / 2
    local col = getFOVColor()

    fovCircleOuter.Position    = Vector2.new(cx, cy)
    fovCircleOuter.Radius      = SA_FOV
    fovCircleOuter.Color       = col
    fovCircleOuter.Visible     = true

    fovCircleInner.Position    = Vector2.new(cx, cy)
    fovCircleInner.Radius      = math.max(SA_FOV * 0.35, 8)
    fovCircleInner.Color       = col
    fovCircleInner.Visible     = true
end

local function getCharHeight(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not root or not head then return 3.0 end
    local rootBottom = root.Position.Y - (root.Size.Y / 2)
    local headTop    = head.Position.Y  + (head.Size.Y / 2)
    return math.max(headTop - rootBottom, 1.5)
end

local function getHeadOffset(char, worldDist)
    local charHeight = getCharHeight(char)
    local refHeight  = 5.0
    local heightScale = refHeight / math.max(charHeight, 1.5)
    local distFactor = (worldDist / 500) ^ 1.4
    local baseOffset = distFactor * 0.55
    return baseOffset * heightScale
end

local SA_WALLCHECK = true

local function isVisible(fromPos, targetPos, targetChar)
    if not SA_WALLCHECK then return true end
    local myChar = LocalPlayer.Character
    local direction = (targetPos - fromPos)
    local distance  = direction.Magnitude
    if distance < 0.1 then return true end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = { myChar, targetChar }
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(fromPos, direction.Unit * distance, rayParams)
    return result == nil
end

local function getSATarget()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local best   = nil
    local bestD  = SA_FOV

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character
        if not char then continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root then continue end

        if isInSafeZone(char) then continue end

        local worldDist = 0
        if myRoot then
            worldDist = (myRoot.Position - root.Position).Magnitude
            if worldDist > SA_MAX_DIST then continue end
            if worldDist < SA_MIN_DIST then continue end
        end

        local headPart   = char:FindFirstChild("Head")
        local targetPart = headPart
                        or char:FindFirstChild("UpperTorso")
                        or char:FindFirstChild("Torso")
                        or root

        local targetPos = targetPart.Position

        if headPart and worldDist > SA_MIN_DIST then
            local yOffset = getHeadOffset(char, worldDist)
            targetPos = Vector3.new(targetPos.X, targetPos.Y + yOffset, targetPos.Z)
        end

        if SA_PREDICTION then
            local vel   = root.AssemblyLinearVelocity
            local ping  = 0.08
            local stats = game:GetService("Stats")
            if stats then
                local ok, ms = pcall(function()
                    return stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                if ok and ms and ms > 0 then ping = ms / 1000 end
            end
            local flatVel = Vector3.new(vel.X, 0, vel.Z)
            targetPos = targetPos + flatVel * ping
        end

        if targetPos.Y < -5 then continue end

        if not isVisible(Camera.CFrame.Position, targetPos, char) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen or screenPos.Z <= 0 then continue end

        local screenV2 = Vector2.new(screenPos.X, screenPos.Y)
        local d = (screenV2 - center).Magnitude
        if d < bestD then
            bestD = d
            best = { plr = plr, part = targetPart, pos = targetPos, dist = worldDist }
        end
    end
    return best
end

local function startSALoop()
    if saLoopConn then saLoopConn:Disconnect() end
    saLoopConn = RunService.RenderStepped:Connect(function()
        if not _G.SilentAim then return end

        updateFOVCircle()

        local target = getSATarget()
        if not target then return end

        local camCF  = Camera.CFrame
        local lookAt = CFrame.lookAt(camCF.Position, target.pos)

        if SA_SMOOTH then
            local dt    = game:GetService("RunService").RenderStepped:Wait()
            local alpha = math.clamp(1 - math.exp(-SA_SMOOTH_SPEED * dt * 10), 0, 1)
            Camera.CFrame = camCF:Lerp(lookAt, alpha)
        else
            Camera.CFrame = lookAt
        end
    end)
    Logger.ok("SILENT AIM", "Loop activo")
end

local function stopSALoop()
    if saLoopConn then saLoopConn:Disconnect(); saLoopConn = nil end
    fovCircleOuter.Visible = false
    fovCircleInner.Visible = false
    Logger.ok("SILENT AIM", "Loop detenido")
end

local function getSources()
    local sources = {}
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if bp   and bp.Parent   then table.insert(sources, bp)   end
    if char and char.Parent then table.insert(sources, char) end
    return sources
end

local function getItemConfig(item)
    local cfg = item:FindFirstChild("Configuration")
    if cfg then return cfg end
    for _, child in ipairs(item:GetChildren()) do
        local nested = child:FindFirstChild("Configuration")
        if nested then return nested end
    end
    return nil
end

local function getWeapons()
    local weapons = {}
    for _, source in ipairs(getSources()) do
        for _, item in ipairs(source:GetChildren()) do
            local cfg = getItemConfig(item)
            if cfg then table.insert(weapons, { item = item, cfg = cfg }) end
        end
    end
    return weapons
end

local function startWeaponLoop()
    if weaponLoopConn then weaponLoopConn:Disconnect() end
    weaponLoopConn = RunService.Heartbeat:Connect(function()
        local anyActive = _G.NoRecoil or _G.NoSpread or _G.RapidFire or _G.InfiniteAmmo or _G.HighDamage
        if not anyActive then return end

        for _, w in ipairs(getWeapons()) do
            local cfg  = w.cfg
            local item = w.item

            if _G.NoRecoil then
                for _, prop in ipairs(RECOIL_PROPS) do
                    local inst = cfg:FindFirstChild(prop)
                    if inst and inst.Value ~= 0 then inst.Value = 0 end
                end
            end

            if _G.NoSpread then
                for _, prop in ipairs(SPREAD_PROPS) do
                    local inst = cfg:FindFirstChild(prop)
                    if inst and inst.Value ~= 0 then inst.Value = 0 end
                end
            end

            if _G.RapidFire then
                local inst = cfg:FindFirstChild("ShotCooldown")
                if inst and inst.Value > 0.05 then inst.Value = 0.05 end
            end

            if _G.InfiniteAmmo then
                local cap = cfg:FindFirstChild("AmmoCapacity")
                if cap then
                    local ca = item:FindFirstChild("CurrentAmmo")
                    if not ca and item.Parent then
                        ca = item.Parent:FindFirstChild("CurrentAmmo")
                    end
                    if ca and ca.Value < cap.Value then ca.Value = cap.Value end
                end
            end

            if _G.HighDamage then
                local dmg = cfg:FindFirstChild("HitDamage")
                if dmg and dmg.Value ~= 999 then dmg.Value = 999 end
            end
        end
    end)
    Logger.ok("WEAPON LOOP", "Loop unificado iniciado")
end

