local function getSilentAimTarget(fovRadius)
    local vp       = Camera.ViewportSize
    local center   = Vector2.new(vp.X / 2, vp.Y / 2)
    local best     = nil
    local bestDist = fovRadius

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum  = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen and screenPos.Z > 0 then
                    local screenV2 = Vector2.new(screenPos.X, screenPos.Y)
                    local dist = (screenV2 - center).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = { plr = plr, root = root }
                    end
                end
            end
        end
    end
    return best
end

local function enableSilentAim()
    if not WeaponHitRemote then
        Logger.err("SILENT AIM", "Remote no disponible aún — reintentando en 1s")
        task.delay(1, enableSilentAim)
        return
    end
    if saHook then return end

    local oldFire = hookfunction(
        WeaponHitRemote.FireServer,
        newcclosure(function(self, tool, hitData)
            if _G.SilentAim and hitData then
                local target = getSilentAimTarget(SA_FOV)
                if target then
                    local root  = target.root
                    local head  = target.plr.Character:FindFirstChild("Head")
                    local aimPart = head or root

                    hitData["part"] = aimPart
                    hitData["h"]    = aimPart
                    hitData["p"]    = aimPart.Position
                    hitData["n"]    = Vector3.new(0, 0, 1)

                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        hitData["d"] = (myRoot.Position - aimPart.Position).Magnitude
                    end
                end
            end
            return oldFire(self, tool, hitData)
        end)
    )
    saHook = oldFire
    Logger.ok("SILENT AIM", "Hook activo — FOV " .. SA_FOV .. "px")
end

local function disableSilentAim()
    if saHook then
        hookfunction(WeaponHitRemote.FireServer, saHook)
        saHook = nil
        Logger.ok("SILENT AIM", "Hook removido")
    end
end

