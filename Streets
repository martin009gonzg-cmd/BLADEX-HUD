local Logger = {}
local function timestamp() return string.format("[%.2fs]", os.clock()) end
function Logger.ok(m, msg)   print(timestamp() .. " [BLADEX][✓] " .. m .. " → " .. msg) end
function Logger.warn(m, msg) warn(timestamp()  .. " [BLADEX][!] " .. m .. " → " .. msg) end
function Logger.err(m, msg)  warn(timestamp()  .. " [BLADEX][✗] " .. m .. " → " .. msg) end
function Logger.info(m, msg) print(timestamp() .. " [BLADEX][i] " .. m .. " → " .. msg) end


local function getRainbowColor(offset)
    return Color3.fromHSV(((tick() * 0.4) + (offset or 0)) % 1, 1, 1)
end

local function getESPColor(plr, offset)
    if _G.RainbowESP then
        return getRainbowColor(offset or 0)
    end
    if _G.EquipoColor then
        if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            return Color3.fromRGB(0, 220, 80)
        end
    end
    return ESPColorManual
end

local function getCharBounds(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local top    = root.Position + Vector3.new(0, 3.2, 0)
    local bottom = root.Position - Vector3.new(0, 3.2, 0)

    local topScreen,    onTop    = Camera:WorldToViewportPoint(top)
    local bottomScreen, onBottom = Camera:WorldToViewportPoint(bottom)

    if topScreen.Z < 0 and bottomScreen.Z < 0 then return nil end
    if not onTop and not onBottom then return nil end

    local height = math.abs(topScreen.Y - bottomScreen.Y)
    local width  = height * 0.55
    local cx     = (topScreen.X + bottomScreen.X) / 2
    local cy     = math.min(topScreen.Y, bottomScreen.Y)

    return {
        x  = cx - width / 2,
        y  = cy,
        w  = width,
        h  = height,
        cx = cx,
        cy = cy,
        dist = bottomScreen.Z,
    }
end


local function newDrawing(dtype, props)
    local d = Drawing.new(dtype)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function createESPForPlayer(plr)
    if espObjects[plr] then return end
    local obj = {}

    obj.boxOutline = newDrawing("Square", {
        Visible = false, Filled = false,
        Color = Color3.new(0,0,0), Thickness = 3, ZIndex = 1,
    })
    obj.box = newDrawing("Square", {
        Visible = false, Filled = false,
        Color = ESPColorManual, Thickness = 1.5, ZIndex = 2,
    })
    obj.name = newDrawing("Text", {
        Visible = false, Color = Color3.fromRGB(255,255,255),
        Size = 13, Center = true, Outline = true,
        OutlineColor = Color3.new(0,0,0), Font = Drawing.Fonts.GothamBold, ZIndex = 3,
    })
    obj.hpBarBg = newDrawing("Square", {
        Visible = false, Filled = true,
        Color = Color3.fromRGB(20,20,20), Thickness = 1, ZIndex = 2,
    })
    obj.hpBar = newDrawing("Square", {
        Visible = false, Filled = true,
        Color = Color3.fromRGB(0,220,80), Thickness = 1, ZIndex = 3,
    })
    obj.dist = newDrawing("Text", {
        Visible = false, Color = Color3.fromRGB(200,200,200),
        Size = 11, Center = true, Outline = true,
        OutlineColor = Color3.new(0,0,0), Font = Drawing.Fonts.Gotham, ZIndex = 3,
    })
    obj.tracer = newDrawing("Line", {
        Visible = false, Color = ESPColorManual, Thickness = 1, ZIndex = 1,
    })

    espObjects[plr] = obj
end

local function removeESPForPlayer(plr)
    if not espObjects[plr] then return end
    for _, d in pairs(espObjects[plr]) do pcall(function() d:Remove() end) end
    espObjects[plr] = nil
end

local function updateESPForPlayer(plr)
    local obj = espObjects[plr]
    if not obj then return end

    local char = plr.Character
    if not char then
        for _, d in pairs(obj) do d.Visible = false end
        return
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        for _, d in pairs(obj) do d.Visible = false end
        return
    end

    local bounds = getCharBounds(char)
    if not bounds then
        for _, d in pairs(obj) do d.Visible = false end
        return
    end

    local color    = getESPColor(plr, 0)
    local colorAlt = getESPColor(plr, 0.33)

    if _G.BoxESP then
        obj.box.Position  = Vector2.new(bounds.x, bounds.y)
        obj.box.Size      = Vector2.new(bounds.w, bounds.h)
        obj.box.Color     = color
        obj.box.Visible   = true

        obj.boxOutline.Position = Vector2.new(bounds.x - 1, bounds.y - 1)
        obj.boxOutline.Size     = Vector2.new(bounds.w + 2, bounds.h + 2)
        obj.boxOutline.Visible  = true
    else
        obj.box.Visible        = false
        obj.boxOutline.Visible = false
    end

    if _G.NombreESP then
        obj.name.Text     = plr.Name
        obj.name.Position = Vector2.new(bounds.cx, bounds.y - 15)
        obj.name.Color    = color
        obj.name.Visible  = true
    else
        obj.name.Visible = false
    end

    if _G.VidaESP then
        local hp    = math.clamp(hum.Health, 0, hum.MaxHealth)
        local maxHp = math.max(hum.MaxHealth, 1)
        local pct   = hp / maxHp
        local barW  = 4
        local barX  = bounds.x - barW - 3
        local barH  = bounds.h
        local barY  = bounds.y
        local fillH = math.max(barH * pct, 1)

        obj.hpBarBg.Position = Vector2.new(barX, barY)
        obj.hpBarBg.Size     = Vector2.new(barW, barH)
        obj.hpBarBg.Visible  = true

        obj.hpBar.Position = Vector2.new(barX, barY + barH - fillH)
        obj.hpBar.Size     = Vector2.new(barW, fillH)
        obj.hpBar.Color    = Color3.fromHSV(pct * 0.33, 1, 1)
        obj.hpBar.Visible  = true
    else
        obj.hpBarBg.Visible = false
        obj.hpBar.Visible   = false
    end

    if _G.DistanciaESP then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local dist = 0
        if myRoot then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then dist = math.floor((myRoot.Position - root.Position).Magnitude) end
        end
        obj.dist.Text     = "[" .. dist .. "m]"
        obj.dist.Position = Vector2.new(bounds.cx, bounds.y + bounds.h + 2)
        obj.dist.Color    = colorAlt
        obj.dist.Visible  = true
    else
        obj.dist.Visible = false
    end

    if _G.TracerESP then
        local vp = Camera.ViewportSize
        obj.tracer.From    = Vector2.new(vp.X / 2, vp.Y)
        obj.tracer.To      = Vector2.new(bounds.cx, bounds.y + bounds.h)
        obj.tracer.Color   = color
        obj.tracer.Visible = true
    else
        obj.tracer.Visible = false
    end
end


local function startESPLoop()
    if espConn then espConn:Disconnect() end
    espConn = RunService.RenderStepped:Connect(function()
        if not _G.ESP then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                if not espObjects[plr] then createESPForPlayer(plr) end
                updateESPForPlayer(plr)
            end
        end
    end)
end

local function stopESPLoop()
    if espConn then espConn:Disconnect(); espConn = nil end
    for plr in pairs(espObjects) do removeESPForPlayer(plr) end
    espObjects = {}
end

