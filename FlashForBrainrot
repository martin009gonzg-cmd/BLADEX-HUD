local INF_MAX_TIER  = 12
local INF_SCAN_DLY  = 0.4

local INF_RARITY_SORTED = {}
do
    local p = {
        hacker=10, lightning=9, blizzard=8, lava=7,
        candy=6, rainbow=5, diamond=4, ["+2"]=2, ["+1"]=1,
    }
    for k,v in pairs(p) do table.insert(INF_RARITY_SORTED,{key=k,priority=v}) end
    table.sort(INF_RARITY_SORTED, function(a,b) return a.priority>b.priority end)
end

local function infMatchKey(text, key)
    if key:match("^%a+$") then
        return text:find("%f[%a]"..key.."%f[%A]") ~= nil
    else return text:find(key,1,true) ~= nil end
end
local function infCheckText(text)
    if not text then return nil end
    local low = text:lower()
    for _,e in ipairs(INF_RARITY_SORTED) do
        if infMatchKey(low, e.key) then return e.key end
    end
end
local function infGetRarity(part)
    local k = infCheckText(part.Name)
    if k then return k end
    for _,d in ipairs(part:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            k = infCheckText(d.Text) if k then return k end
        end
        k = infCheckText(d.Name) if k then return k end
    end
end
local function infGetParts()
    local parts = {}
    local bw = workspace:FindFirstChild("BuffWalls") or workspace:FindFirstChild("Walls")
    if bw then
        for _,d in ipairs(bw:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts,d) end
        end
    else
        for _,d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then
                local n = d.Name:lower()
                if n:find("buff") or n:find("arrow") or n:find("boost") then
                    table.insert(parts,d)
                end
            end
        end
    end
    return parts
end
