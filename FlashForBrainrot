local function esperarBrainrot(timeout)
    local recibido = false
    local nombre   = "?"
    local conns    = {}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local ok, conn = pcall(function()
                return obj.OnClientEvent:Connect(function(msg, num, tipo)
                    if tipo == "Success" and tostring(msg):find("Added!") then
                        nombre   = tostring(msg):gsub(" Added!", "")
                        recibido = true
                    end
                end)
            end)
            if ok and conn then table.insert(conns, conn) end
        end
    end
    local t = 0
    while not recibido and t < timeout do
        task.wait(0.1)
        t += 0.1
    end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    return recibido, nombre
end

local function loopFarmBrain()
    local zonaActual, zonaIdx = getZone()

    while _G.AutoFarmBrainrots do
        local char, hrp = getFarmCharacter()

        if char and hrp then
            local nuevaZona, nuevoIdx = getZone()
            if nuevoIdx ~= zonaIdx then
                zonaIdx    = nuevoIdx
                zonaActual = nuevaZona
            end

            if DE then pcall(function() DE:FireServer("EndWarp") end) end
            task.wait(0.5)

            hrp.CFrame = CFrame.new(zonaActual.pos)
            task.wait(0.5)

            if DE then pcall(function() DE:FireServer("StartCharge") end) end
            task.wait(0.9)
            if DE then pcall(function() DE:FireServer(3) end) end

            local scanActivo = true
            local buffThread = task.spawn(function()
                while scanActivo and _G.AutoFarmBrainrots do
                    local parts = infGetParts()
                    for _, part in ipairs(parts) do
                        if not scanActivo then break end
                        local key = infGetRarity(part)
                        if key == "+1" or key == "+2" then
                            infTouch(part, hrp)
                            task.wait(0.15)
                        end
                    end
                    task.wait(INF_SCAN_DLY)
                end
            end)

            local ok, nombre = esperarBrainrot(10)

            scanActivo = false
            pcall(task.cancel, buffThread)

            _ = ok

            task.wait(0.8)
        else
            task.wait(1)
        end
    end
end

local UPG_SUFFIXES = {
    {"Qa", 1e15}, {"Qi", 1e18}, {"Sx", 1e21}, {"Sp", 1e24},
    {"Oc", 1e27}, {"No", 1e30}, {"Dc", 1e33},
    {"K",  1e3},  {"M",  1e6},  {"B",  1e9},  {"T",  1e12},
}
local function upgParseNumber(str)
    if not str or str == "" then return nil end
    str = str:gsub("[$,%s+]", "")
    if str == "" then return nil end
    for _, pair in ipairs(UPG_SUFFIXES) do
        local suffix, mult = pair[1], pair[2]
        local num = str:match("^([%d%.]+)" .. suffix .. "$")
        if num then
            local n = tonumber(num)
            if n then return n * mult end
        end
    end
    return tonumber(str)
end

local UPG_MONEY_FOLDERS = {
    "leaderstats", "Data", "Stats", "PlayerData",
    "Currencies", "Currency", "GameData", "PlayerStats",
    "Resources", "Wallet", "Economy",
}
local UPG_MONEY_NAMES = {
    "Cash", "Money", "Coins", "Gold", "Currency",
    "Dinero", "Gems", "Credits", "Caramelos",
    "Bucks", "Dollar", "Dollars", "Balance",
}
local function upgIsMoneyValue(v)
    return v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue")
end
local function upgSearchFolder(folder)
    for _, mName in ipairs(UPG_MONEY_NAMES) do
        local v = folder:FindFirstChild(mName)
        if v and upgIsMoneyValue(v) then return v end
    end
    for _, v in ipairs(folder:GetChildren()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then return v end
    end
    for _, v in ipairs(folder:GetChildren()) do
        if v:IsA("StringValue") and upgParseNumber(v.Value) ~= nil then return v end
    end
    return nil
end
local function upgFindMoney()
    local lp = Players.LocalPlayer
    for _, folderName in ipairs(UPG_MONEY_FOLDERS) do
        local folder = lp:FindFirstChild(folderName)
        if folder then
            local v = upgSearchFolder(folder)
            if v then return v end
        end
    end
    for _, child in ipairs(lp:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Configuration") then
            for _, mName in ipairs(UPG_MONEY_NAMES) do
                local v = child:FindFirstChild(mName)
                if v and upgIsMoneyValue(v) then return v end
            end
        end
    end
    for _, attrName in ipairs(UPG_MONEY_NAMES) do
        local v = lp:GetAttribute(attrName)
        if type(v) == "number" then
            return { _isAttr = true, _name = attrName }
        end
    end
    return nil
end

local _upgMoneyRef = nil
local function upgEnsureMoney()
    if not _upgMoneyRef then _upgMoneyRef = upgFindMoney(); return end
    if type(_upgMoneyRef) == "table" then return end
    if not _upgMoneyRef.Parent then _upgMoneyRef = upgFindMoney() end
end
local function upgGetMoney()
    if not _upgMoneyRef then return nil end
    local lp = Players.LocalPlayer
    if type(_upgMoneyRef) == "table" then
        local v = lp:GetAttribute(_upgMoneyRef._name)
        return type(v) == "number" and v or upgParseNumber(tostring(v))
    end
    if _upgMoneyRef:IsA("StringValue") then return upgParseNumber(_upgMoneyRef.Value) end
    return _upgMoneyRef.Value
end

