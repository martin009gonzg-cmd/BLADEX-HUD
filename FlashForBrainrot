        while _G.AutoInfinityFarm do
            local tier = infGetTier()
            if rainbowTouched and tier >= INF_MAX_TIER then break end

            local parts = infGetParts()
            for _, part in ipairs(parts) do
                if not _G.AutoInfinityFarm then break end
                local key = infGetRarity(part)
                if not key then continue end

                if key == "rainbow" and not rainbowTouched then
                    infTouch(part, hrp)
                    rainbowTouched = true
                    task.wait(0.4)
                elseif key == "+2" or key == "+1" then
                    infTouch(part, hrp)
                    task.wait(0.15)
                end
            end
            task.wait(INF_SCAN_DLY)
        end

        if not _G.AutoInfinityFarm then break end
        if DE then pcall(DE.FireServer, DE, "EndWarp") end
        task.wait(1.8)
    end
end

