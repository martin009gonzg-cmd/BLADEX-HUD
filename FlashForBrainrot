local _upgCostCache = setmetatable({}, {__mode = "k"})
local UPG_COST_SFX  = {"Qa","Qi","Sx","Sp","Oc","No","Dc","K","M","B","T"}
local UPG_EXCLUDE   = {"income","titulo","title","name","nivel","level","rank"}

local function upgLooksCost(text)
    if not text or text == "" then return false end
    if text:match("%$") then return true end
    for _, s in ipairs(UPG_COST_SFX) do
        if text:match("%d" .. s) then return true end
    end
    return false
end
local function upgIsExcluded(name)
    local n = name:lower()
    for _, e in ipairs(UPG_EXCLUDE) do
        if n:match(e) then return true end
    end
    return false
end
local function upgCostKey(stand)
    local parts = {}
    for _, d in ipairs(stand:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not upgIsExcluded(d.Name) then
            local t = d.Text or ""
            if upgLooksCost(t) then table.insert(parts, d.Name .. "=" .. t) end
        end
    end
    table.sort(parts)
    return table.concat(parts, "|")
end
local function upgGetCost(stand)
    local key    = upgCostKey(stand)
    local cached = _upgCostCache[stand]
    if cached and cached.key == key then return cached.cost end
    local candidates = {}
    for _, d in ipairs(stand:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not upgIsExcluded(d.Name) then
            local t = d.Text or ""
            if upgLooksCost(t) then
                local n = upgParseNumber(t)
                if n then
                    local nl = d.Name:lower()
                    local pri = (nl:match("cost") or nl:match("upgrade")
                        or nl:match("precio") or nl:match("price")) and 1 or 2
                    table.insert(candidates, { n = n, priority = pri })
                end
            end
        end
    end
    if #candidates == 0 then
        _upgCostCache[stand] = { key = key, cost = nil }
        return nil
    end
    table.sort(candidates, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.n < b.n
    end)
    local cost = candidates[1].n
    _upgCostCache[stand] = { key = key, cost = cost }
    return cost
end

local function upgRunCycle(base)
    local ms = base:FindFirstChild("ModelStands")
    if not ms then return 0 end
    local standList = {}
    for _, child in ipairs(ms:GetChildren()) do
        if child.Name:match("^ModelStand%d+$") then
            table.insert(standList, child)
        end
    end
    table.sort(standList, function(a, b)
        local ca = upgGetCost(a) or math.huge
        local cb = upgGetCost(b) or math.huge
        return ca < cb
    end)
    local ok_count = 0
    for _, stand in ipairs(standList) do
        if not _G.AutoUpgradeBrain then break end
        if not upgIsEmpty(stand) and not upgIsMax(stand) then
            local money = upgGetMoney()
            local cost  = upgGetCost(stand)
            if money and cost and money >= cost then
                local upgraded = false
                for _ = 1, 3 do
                    local ok = pcall(function() UBR:FireServer(base, stand) end)
                    if ok then upgraded = true; break end
                    task.wait(0.1)
                end
                if upgraded then ok_count = ok_count + 1 end
                task.wait(0.15)
            else
                task.wait(0.05)
            end
        end
    end
    return ok_count
end

