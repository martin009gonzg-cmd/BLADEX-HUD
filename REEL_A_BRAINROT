local dupeStates = {
    AutoBase=false, Base1=false, Base2=false, Base3=false,
    Base4=false,    Base5=false, Base6=false,
}
local dupeLoops = {}

local function _getDupeBrainrot()
    local charFolder = workspace:FindFirstChild(LP.Name)
    if charFolder then
        for _, v in pairs(charFolder:GetDescendants()) do
            if string.find(v.Name, "Brainrot") then return v.Name end
        end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in pairs(bp:GetChildren()) do
            if string.find(t.Name, "Brainrot") then return t.Name end
        end
    end
    return "Brainrot1:Normal:1:1:0"
end

local function _hasBrainrot(plotFolder)
    for _, v in pairs(plotFolder:GetChildren()) do
        if string.find(v.Name, "Brainrot") then return true end
    end
    return false
end

local function _getMyBase()
    local myName = LP.Name
    local myId   = tostring(LP.UserId)
    local Bases  = workspace:FindFirstChild("Bases")
    if not Bases then return nil end
    for _, base in pairs(Bases:GetChildren()) do
        local objects = base:FindFirstChild("Objects")
        if not objects then continue end
        local ownerBoard = objects:FindFirstChild("OwnerBoard")
        if ownerBoard then
            for _, desc in pairs(ownerBoard:GetDescendants()) do
                if desc:IsA("TextLabel") and (desc.Text == myName or desc.Text == myId) then
                    return objects
                end
            end
        end
        for _, child in pairs(base:GetChildren()) do
            if child:IsA("StringValue") or child:IsA("IntValue") then
                local val = tostring(child.Value)
                if val == myId or val == myName then return objects end
            end
        end
        local attr = base:GetAttribute("Owner") or base:GetAttribute("OwnerId")
        if attr and (tostring(attr) == myId or tostring(attr) == myName) then
            return objects
        end
    end
    return nil
end

local function _startDupe(key, getBaseFn)
    if dupeLoops[key] then return end
    dupeLoops[key] = task.spawn(function()
        local ITEM = _getDupeBrainrot()
        local Base = getBaseFn()
        if not Base then
            dupeStates[key] = false
            dupeLoops[key]  = nil
            return
        end
        local threads = {}
        for i = 1, 30 do
            threads[i] = task.spawn(function()
                while dupeStates[key] do
                    local p = "Plot" .. i
                    local f = Base:FindFirstChild(p)
                    if f and not _hasBrainrot(f) then
                        pcall(function() _Remote:FireServer("Add", p, ITEM) end)
                    end
                    task.wait(0.05)
                end
            end)
        end
        while dupeStates[key] do task.wait(0.5) end
        for _, t in pairs(threads) do pcall(task.cancel, t) end
        dupeLoops[key] = nil
    end)
end

local function _stopDupe(key)
    dupeStates[key] = false
    if dupeLoops[key] then task.cancel(dupeLoops[key]); dupeLoops[key] = nil end
end

