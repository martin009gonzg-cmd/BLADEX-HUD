end

local function slotNecesita(slots, i)
    local s = slots[i]
    return s and s.submitted == false
end

local function equipar(tool)
    local c = LP.Character
    if not c or not tool or not tool.Parent then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.3)
    return true
end

local function submitSlot(slotIndex, brainrotTool)
    local c = LP.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local brainrotId = (brainrotTool and brainrotTool:GetAttribute("id")) or (brainrotTool and brainrotTool.Name)
    local posOriginal = hrp.CFrame
    hrp.CFrame = CFrame.new(SLOT_POS[slotIndex])
    task.wait(0.3)
    local rh = ReplicatedStorage:FindFirstChild("RemoteHandler")
    local disparado = false
    if rh then
        local submitRF = rh:FindFirstChild("KrakenSacrificeSubmit")
        if submitRF then
            local ok, result = pcall(function() return submitRF:InvokeServer(slotIndex, brainrotId) end)
            if ok and result then disparado = true end
        end
    end
    if not disparado then
        local bestPP, bestDist = nil, 20
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local part = d.Parent
                if part and part:IsA("BasePart") then
                    local dist = (part.Position - SLOT_POS[slotIndex]).Magnitude
                    if dist < bestDist then bestDist = dist; bestPP = d end
                end
            end
        end
        if bestPP then
            pcall(function() fireproximityprompt(bestPP) end)
            disparado = true
        end
    end
    task.wait(0.3)
    hrp.CFrame = posOriginal
    return disparado
end

local function hacerClaim()
    local rh = ReplicatedStorage:FindFirstChild("RemoteHandler")
    if rh then
        local fn = rh:FindFirstChild("KrakenClaimFinal")
                   or rh:FindFirstChild("KrakenClaim")
                   or rh:FindFirstChild("KrakenReward")
        if fn then pcall(function() fn:InvokeServer() end) end
    end
    task.wait(0.3)
    for _, d in ipairs(Workspace:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and (d.Text == "Claim" or d.Text == "Reclamar") then
            pcall(function() d:activate() end)
        end
    end
end

local function getResetSegundos()
    local rh = ReplicatedStorage:FindFirstChild("RemoteHandler")
    if not rh then return nil end
    local rfSnap = rh:FindFirstChild("KrakenSacrificeSnapshot")
    if not rfSnap then return nil end
    local ok, snap = pcall(function() return rfSnap:InvokeServer() end)
    if not ok or not snap then return nil end
    if snap.nextRoundAt and snap.nextRoundAt > 0 and snap.serverNow then
        local remaining = snap.nextRoundAt - snap.serverNow
        if remaining > 0 then return remaining end
    end
    return (snap.roundCooldown and snap.roundCooldown > 0) and snap.roundCooldown or 185
end

local function esperarReset()
    local intentos = 0
    while autoSubmitOn and _submitRunning do
        local secs = getResetSegundos()
        if secs and secs > 0 then task.wait(secs + 5) return end
        intentos = intentos + 1
        if intentos >= 10 then task.wait(185) return end
        task.wait(3)
    end
end

local function startAutoSubmit()
    _submitRunning = true
    task.spawn(function()
        while autoSubmitOn and _submitRunning do
            local slots = getSlots()
            if not slots then task.wait(3) continue end
            local pendientes = 0
            for i = 1, 3 do if slotNecesita(slots, i) then pendientes = pendientes + 1 end end
            if pendientes == 0 then
                hacerClaim() task.wait(1) hacerClaim()
                esperarReset()
                continue
            end
            for i = 1, 3 do
                if not autoSubmitOn or not _submitRunning then break end
                local fresh = getSlots()
                if not fresh then task.wait(1) break end
                if not slotNecesita(fresh, i) then continue end
                local br = getBrainrotParaSubmit()
                if not br then
                    local bp = LP:FindFirstChildOfClass("Backpack")
                    if bp then
                        for _, t in ipairs(bp:GetChildren()) do
                            if t:IsA("Tool") then
                                local n = t.Name:lower()
                                local esMalo = false
                                for _, w in ipairs(NO_BRAINROT) do
                                    if n:find(w, 1, true) then esMalo = true break end
                                end
                                if not esMalo then br = t break end
                            end
                        end
                    end
                    if not br then task.wait(10) break end
                end
                equipar(br) task.wait(0.2)
                submitSlot(i, br)
                if i < 3 then task.wait(6) end
            end
            task.wait(2)
        end
    end)
end

