local function comprarViaMerchantRemote()
    local rh = ReplicatedStorage:FindFirstChild("RemoteHandler")
    if not rh then return end
    local rfBuy      = rh:FindFirstChild("KrakenMerchantBuy")
    local rfSnapshot = rh:FindFirstChild("KrakenMerchantSnapshot")
    if not rfBuy or not rfSnapshot then return end
    local ok, snap = pcall(function() return rfSnapshot:InvokeServer() end)
    if not ok or not snap or not snap.offers then return end
    local monedas = snap.currency and snap.currency.balance or 0
    for i, offer in ipairs(snap.offers) do
        if not autoBuyOn then break end
        local id   = offer.id
        local cost = offer.cost or 0
        local name = tostring(id or ""):lower()
        if not itemDeseado(name) then continue end
        if offer.stock and offer.stock > 0 and offer.purchased == false and monedas >= cost then
            local ok1, r1 = pcall(function() return rfBuy:InvokeServer(id) end)
            if ok1 and r1 then
                monedas = monedas - cost
            else
                local ok2, r2 = pcall(function() return rfBuy:InvokeServer(i) end)
                if ok2 and r2 then monedas = monedas - cost end
            end
            task.wait(0.5)
        end
    end
end

