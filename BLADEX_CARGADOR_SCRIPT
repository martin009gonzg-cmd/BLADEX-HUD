local function _BLADEX_INIT()
    local _game = game
    local _getgenv = getgenv
    local _task = task
    local _pcall = pcall
    local _HttpService = _game:GetService("HttpService")

    local WEBHOOK_URL   = "https://discord.com/api/webhooks/1520231455018717324/n17zswyXGIthVmYyJXBGbqdo93zKcL7ZE_TLGSLGmwOfy11I3AY1GXjiWqM5FOPbldN1"
    local LOGGER_URL    = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/BLADEX_LOGGER"
    local CACHE_FOLDER  = "bladex_cache/"
    local CACHE_TTL     = 3600

    local HAS_FILE_ACCESS = type(writefile) == "function" and type(isfile) == "function" and type(readfile) == "function"

    local function notify(title, msg, duration)
        duration = duration or 5
        local lib = _getgenv().Compkiller
        if lib and lib.newNotify then
            local ok = _pcall(lib.newNotify, lib, title, msg, duration)
            if not ok then print(string.format("[BLADEX] %s: %s", title, msg)) end
        else
            print(string.format("[BLADEX] %s: %s", title, msg))
        end
    end

    local function getCacheFileName(url)
        local hash = _HttpService:JSONEncode({url = url}):sub(2, -2)
        local safe = url:gsub("[%p%c]", "_"):sub(1, 40)
        return CACHE_FOLDER .. "bladex_" .. safe .. "_" .. (#hash > 20 and hash:sub(1, 20) or hash) .. ".txt"
    end

    local function secureDownload(url, ttl)
        if url == "" then return nil end
        ttl = ttl or CACHE_TTL

        local fileName = getCacheFileName(url)
        local now = os.time()

        if HAS_FILE_ACCESS and isfile(fileName) then
            local ok, info = _pcall(function() return getfileinfo(fileName) end)
            if ok and info and info.size > 0 then
                local modified = info.modified or 0
                if (now - modified) < ttl then
                    local cached = readfile(fileName)
                    if cached and #cached > 50 then return cached end
                end
            end
        end

        for attempt = 1, 3 do
            local success, result
            if _game.HttpGet then
                success, result = _pcall(function() return _game:HttpGet(url) end)
            elseif syn and syn.request then
                success, result = _pcall(function()
                    local res = syn.request({Url = url, Method = "GET"})
                    return res and res.Body
                end)
            else
                notify("Error", "No se encontrÃ³ mÃ©todo HTTP disponible")
                return nil
            end

            if success and result and #result > 50 then
                if HAS_FILE_ACCESS then _pcall(writefile, fileName, result) end
                return result
            end
            _task.wait(0.3)
        end

        if HAS_FILE_ACCESS and isfile(fileName) then return readfile(fileName) end
        return nil
    end

    local DEFAULT_GAMES = {
        [124473577469410] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/Be_a_Lucky_Block",         name = "Lucky Block Sim"},
        [134190049316507] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/Spear%20a%20Brainrots",    name = "Spear a Brainrots"},
        [82338709069161]  = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/Brainrot%20Morph%20Tower", name = "Brainrot Morph Tower"},
        [136066387156306] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/FlashForBrainrot",         name = "Be A Flash For Brainrot"},
        [139054513518556] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/BeAHair",                  name = "Be A Hair"},
        [110308882298123] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/UpgradeLuckyBlock",        name = "UpgradeLuckyBlock"},
        [117571771385668] = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/Streets",                  name = "Streets"},
        [75888315541325]  = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/PushRockBrainrots",        name = "Push Rock for Brainrots"},
        [84575720768520]  = {url = "https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/LuckyBlockRush",           name = "Lucky Block Rush"},
    }

    if _getgenv()._BLADEX_LOADING then
        notify("Advertencia", "Ya hay una instancia cargando", 3)
        return
    end
    _getgenv()._BLADEX_LOADING = true

    local currentId = _game.PlaceId
    local gameData  = DEFAULT_GAMES[currentId]

    if not gameData then
        warn(string.format("[BLADEX] ID %s no configurado", tostring(currentId)))
        notify("Juego no soportado", "UID: " .. tostring(currentId), 6)
        _getgenv()._BLADEX_LOADING = nil
        return
    end

    local libCode, loggerCode
    local libDone, loggerDone, scriptDone = false, false, false
    local scriptCode

    _task.spawn(function()
        if not _getgenv().Compkiller then
            libCode = secureDownload("https://raw.githubusercontent.com/martin009gonzg-cmd/BLADEX-HUD/refs/heads/main/BLADEX_LIBRERIA", 7200)
        end
        libDone = true
    end)

    _task.spawn(function()
        if not _getgenv().BladexLogger then
            loggerCode = secureDownload(LOGGER_URL, 7200)
        end
        loggerDone = true
    end)

    _task.spawn(function()
        scriptCode = secureDownload(gameData.url, 3600)
        scriptDone = true
    end)

    while not (libDone and loggerDone and scriptDone) do _task.wait(0.05) end

    if not _getgenv().Compkiller then
        if libCode then
            local func, err = loadstring(libCode)
            if func then
                local success, obj = _pcall(func)
                if success then
                    _getgenv().Compkiller = obj
                else
                    notify("Error", "Fallo al inicializar librerÃ­a: " .. tostring(obj))
                end
            else
                notify("Error", "LibrerÃ­a corrupta: " .. tostring(err))
            end
        else
            notify("Error", "No se pudo descargar la librerÃ­a")
        end
    end

    if not _getgenv().BladexLogger then
        if loggerCode then
            local func, err = loadstring(loggerCode)
            if func then
                local success, obj = _pcall(func)
                if success then _getgenv().BladexLogger = obj end
            end
        end
    end

    local Logger = _getgenv().BladexLogger
    notify("BLADEX HUB", "Iniciando " .. gameData.name, 3)

    if scriptCode then
        local mainFunc, compErr = loadstring(scriptCode)
        if mainFunc then
            local env = getfenv(mainFunc)
            env.Compkiller = _getgenv().Compkiller
            setfenv(mainFunc, env)
            local success, execErr = xpcall(mainFunc, function(e)
                local tr = ""
                _pcall(function() tr = debug.traceback(e, 2) end)
                return tr ~= "" and tr or e
            end)
            if success then
                notify("Cargado correctamente", gameData.name .. " | UID: " .. tostring(currentId), 5)
                if Logger and WEBHOOK_URL ~= "TU_WEBHOOK_AQUI" then
                    Logger._scriptName = gameData.name
                    Logger._webhookUrl = WEBHOOK_URL
                    Logger._cooldowns  = {}
                    local c = {
                        game     = _game.Name or "?",
                        placeId  = tostring(currentId),
                        player   = "?",
                        userId   = "?",
                        platform = "?",
                        executor = "?",
                        time     = "?",
                        date     = "?",
                    }
                    _pcall(function()
                        local Players = _game:GetService("Players")
                        local UIS     = _game:GetService("UserInputService")
                        local lp      = Players.LocalPlayer
                        local mob     = UIS.TouchEnabled and not UIS.KeyboardEnabled
                        c.player   = lp and lp.Name or "?"
                        c.userId   = tostring(lp and lp.UserId or 0)
                        c.platform = mob and "\xF0\x9F\x93\xB1 Mobile" or "\xF0\x9F\x92\xBB PC"
                        c.time     = os.date("%H:%M:%S")
                        c.date     = os.date("%d/%m/%Y")
                        if _G.identifyexecutor then
                            local ok2, name, ver = _pcall(_G.identifyexecutor)
                            c.executor = ok2 and name or "Unknown"
                        elseif _G.Delta then c.executor = "Delta"
                        elseif _G.syn   then c.executor = "Synapse X"
                        else c.executor = "Unknown" end
                    end)
                    local HttpService = _game:GetService("HttpService")
                    local function httpPost(data)
                        if _G.syn and _G.syn.request then _pcall(_G.syn.request, data)
                        elseif _G.request then _pcall(_G.request, data)
                        elseif _G.http and _G.http.request then _pcall(_G.http.request, data)
                        end
                    end
                    local fields = {
                        { name = "\xF0\x9F\x93\x9C Script",    value = gameData.name,   inline = true },
                        { name = "\xF0\x9F\x8E\xAE Juego",     value = c.game,          inline = true },
                        { name = "\xF0\x9F\x94\xA2 PlaceId",   value = c.placeId,       inline = true },
                        { name = "\xF0\x9F\x94\xA7 Executor",  value = c.executor,      inline = true },
                        { name = "Plataforma",                  value = c.platform,      inline = true },
                        { name = "\xF0\x9F\x95\x90 Hora",      value = c.time,          inline = true },
                        { name = "\xF0\x9F\x91\xA4 Jugador",   value = c.player,        inline = true },
                        { name = "\xF0\x9F\x94\xA2 UserId",    value = c.userId,        inline = true },
                        { name = "\xE2\x9C\x85 Estado",        value = "Ejecutado correctamente", inline = true },
                    }
                    local footer = { text = "BLADEX Logger v2.0  |  " .. c.date .. "  |  PlaceId: " .. c.placeId }
                    local ok2, body = _pcall(HttpService.JSONEncode, HttpService, {
                        embeds = {{ title = "\xF0\x9F\x9F\xA2 Session Start - " .. gameData.name, color = 5701903, fields = fields, footer = footer }}
                    })
                    if ok2 then httpPost({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body }) end
                end
            else
                notify("No se pudo ejecutar", gameData.name .. " | UID: " .. tostring(currentId), 6)
                if Logger and WEBHOOK_URL ~= "TU_WEBHOOK_AQUI" then
                    Logger._scriptName = gameData.name
                    Logger._webhookUrl = WEBHOOK_URL
                    Logger._cooldowns  = {}
                    Logger.error(gameData.name, tostring(execErr))
                end
            end
        else
            notify("Script invalido", gameData.name .. " | UID: " .. tostring(currentId), 6)
        end
    else
        notify("No se pudo ejecutar", gameData.name .. " | UID: " .. tostring(currentId), 5)
    end

    _getgenv()._BLADEX_LOADING = nil
end

task.spawn(_BLADEX_INIT)
