local function isGiftClaimed(i)
    local c = getPlaytimeController()
    if not c then return false end
    local ok, r = pcall(function() return c:IsGiftClaimed(i) end)
    return ok and r == true
end

local function loopAutoPlaytimeRewards()
    for _ = 1, 20 do
        if not _G.AutoPlaytimeRewards then return end
        if getPlaytimeController() then break end
        task.wait(1)
    end
    for _ = 1, 30 do
        if not _G.AutoPlaytimeRewards then return end
        if getSessionTime() > 0 then break end
        task.wait(1)
    end
    local claimed = {}
    local function claimAvailable()
        local rf = getPlaytimeRF()
        if not rf then return end
        local sessionTime = getSessionTime()
        for i = 1, 12 do
            if not _G.AutoPlaytimeRewards then return end
            if claimed[i] then continue end
            if sessionTime < _playtimeGiftTimes[i] then continue end
            local ok, res = pcall(rf.InvokeServer, rf, i)
            if ok and res == true then
                claimed[i] = true
                task.wait(0.3)
                if i == 12 then
                    task.wait(2)
                    claimed = {}
                end
            elseif ok and res == false then
                claimed[i] = true
            end
        end
    end
    claimAvailable()
    while _G.AutoPlaytimeRewards do
        task.wait(5)
        claimAvailable()
    end
end

