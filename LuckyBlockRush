local MUTATION_MAP = {
    NORMAL   = "Normal",
    CANDY    = "Candy",
    GOLD     = "Gold",
    DIAMOND  = "Diamond",
    VOID     = "Void",
}

local function getMutationLabel(mutationKey)
    if not mutationKey then return "Normal" end
    return MUTATION_MAP[mutationKey:upper()] or (mutationKey:sub(1,1):upper() .. mutationKey:sub(2):lower())
end

local function shouldSell(mutLabel, rarityLabel)
    local sellMut = _G.ShellSellMutations or {}
    local sellRar = _G.ShellSellRarities  or {}
    if #sellMut == 0 and #sellRar == 0 then return false end

    local mutOk = (#sellMut == 0)
    if not mutOk then
        for _, m in ipairs(sellMut) do
            if mutLabel:lower() == m:lower() then mutOk = true break end
        end
    end

    local rarOk = (#sellRar == 0)
    if not rarOk then
        for _, r in ipairs(sellRar) do
            if rarityLabel:lower() == r:lower() then rarOk = true break end
        end
    end

    if #sellMut > 0 and #sellRar > 0 then return mutOk and rarOk end
    if #sellMut > 0 then return mutOk end
    return rarOk
end

local function loopAutoSellBrainrots()
    while _G.AutoShellInteligente do
        pcall(function()
            if not rfSellBrainrot then return end
            local inv = getPlayerInventory()
            if not inv then return end

            for uid, item in pairs(inv) do
                if not _G.AutoShellInteligente then break end
                if item.itemType == "Brainrot" then
                    local entity     = item.innerEntity
                    if not entity then continue end
                    local mutKey     = entity.mutation or "NORMAL"
                    local mutLabel   = getMutationLabel(mutKey)
                    local rarLabel   = entity.rarity or "Normal"

                    if shouldSell(mutLabel, rarLabel) then
                        pcall(rfSellBrainrot.InvokeServer, rfSellBrainrot, entity.id)
                        task.wait(0.15)
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end

