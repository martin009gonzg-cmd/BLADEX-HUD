local function bossTeleport()
    local r = getBossRemote("TeleportToWorld")
    if r then r:InvokeServer() task.wait(1.5) end
end

local function bossEnd() end

local function bossStopAll()
    _bossRunning = false
    if _bossAttackLoop then _bossAttackLoop:Disconnect() _bossAttackLoop = nil end
    if _bossMonitor    then _bossMonitor:Disconnect()    _bossMonitor    = nil end
end

local function bossStartAttack(boss)
    local lastAttack = 0
    _bossAttackLoop = RunService.Heartbeat:Connect(function()
        if not _bossRunning then return end
        if not boss or not boss.Parent then bossEnd() bossStopAll() return end
        local hp = boss:GetAttribute("Hp")
        if hp and hp <= 0 then bossEnd() bossStopAll() return end
        local now = os.clock()
        if now - lastAttack >= 0.2 then
            lastAttack = now
            pcall(function()
                local controller = require(
                    LocalPlayer.PlayerScripts
                        :WaitForChild("Controllers")
                        :WaitForChild("GlobalBossController")
                )
                if controller and controller.AttackBoss then
                    controller:AttackBoss()
                end
            end)
        end
    end)
end

local function bossStartMonitor(boss)
    _bossMonitor = RunService.Heartbeat:Connect(function()
        if not _bossRunning then return end
        if not boss or not boss.Parent then bossEnd() bossStopAll() return end
        local hp = boss:GetAttribute("Hp")
        if hp and hp <= 0 then bossEnd() bossStopAll() return end
        if not LocalPlayer:GetAttribute("InGlobalBossWorld") then
            if _bossAttackLoop then _bossAttackLoop:Disconnect() _bossAttackLoop = nil end
            bossTeleport()
            if boss and boss.Parent then
                local currentHp = boss:GetAttribute("Hp")
                if not currentHp or currentHp > 0 then
                    bossStartAttack(boss)
                else
                    bossEnd() bossStopAll()
                end
            else
                bossEnd() bossStopAll()
            end
        end
    end)
end

local function bossOnDetected(boss)
    if _bossRunning then bossStopAll() end
    _bossRunning = true
    if not LocalPlayer:GetAttribute("InGlobalBossWorld") then bossTeleport() end
    if not boss or not boss.Parent then _bossRunning = false return end
    bossStartAttack(boss)
    bossStartMonitor(boss)
end

local _bossChildConn = nil

local function startAutoBoss()
    local existing = Bosses:FindFirstChild("globalBoss1")
    if existing then bossOnDetected(existing) end
    _bossChildConn = Bosses.ChildAdded:Connect(function(child)
        if child.Name == "globalBoss1" then bossOnDetected(child) end
    end)
end

local function stopAutoBoss()
    bossStopAll()
    if _bossChildConn then _bossChildConn:Disconnect() _bossChildConn = nil end
end

